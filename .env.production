# Production environment — used by `vite build` (Vercel deployment)
# Vite automatically loads this file when building for production.

# API calls go to the same origin and vercel.json proxies /api/* to the Render backend.
# Same-origin keeps the refresh-token cookie first-party, so browsers that block
# third-party cookies (Safari, Firefox, incognito) don't log the user out.
VITE_API_BASE_URL=/api

# Socket.IO connects directly to the backend (Vercel rewrites can't proxy WebSockets).
# It authenticates with the access token, so no cookie is needed here.
VITE_SOCKET_URL=https://todo-server-zop5.onrender.com
